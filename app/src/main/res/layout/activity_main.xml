<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forwarder Configuration"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Telegram Settings"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="8dp"/>

        <EditText
            android:id="@+id/etTgBotToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Telegram Bot Token"
            android:inputType="text"/>

        <EditText
            android:id="@+id/etTgChatId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Telegram Chat ID"
            android:inputType="text"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Supabase Settings (Optional)"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/etSupabaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Supabase URL (e.g. https://xyz.supabase.co)"
            android:inputType="textUri"/>

        <EditText
            android:id="@+id/etSupabaseKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Supabase Anon/Service Key"
            android:inputType="text"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email / Webhook URL (Optional)"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/etEmailWebhook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Webhook URL"
            android:inputType="textUri"/>

        <Button
            android:id="@+id/btnSaveConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Configuration"
            android:layout_marginTop="16dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Permissions &amp; Power Savings"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/btnGrantSmsPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Grant SMS Permissions"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnGrantNotificationPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Enable Notification Listener Access"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnDisableBatteryOpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Allow Background (Disable Power Saving Restriction)"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvPendingCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Offline Unsent Queue: 0 messages"
            android:textColor="#008000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Ready"
            android:textColor="#333333"
            android:textSize="14sp"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>
