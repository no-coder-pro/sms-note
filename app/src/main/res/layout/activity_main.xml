<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forwarder Configuration"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Saved Credentials Compact Summary Card -->
        <LinearLayout
            android:id="@+id/layoutSavedCredentials"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#10000000"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 Credentials Saved &amp; Active"
                android:textStyle="bold"
                android:textColor="#008000"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvSavedSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Telegram Bot: Configured\n• Supabase: Configured\n• Webhook: Configured"
                android:textSize="13sp"
                android:textColor="#555555"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnEditConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Edit Credentials"/>
        </LinearLayout>

        <!-- Credentials Form View (Editable) -->
        <LinearLayout
            android:id="@+id/layoutEditCredentials"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Telegram Settings"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="8dp"/>

            <EditText
                android:id="@+id/etTgBotToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Telegram Bot Token"
                android:inputType="text"/>

            <EditText
                android:id="@+id/etTgChatId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Telegram Chat ID"
                android:inputType="text"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Supabase Settings (Optional)"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="16dp"/>

            <EditText
                android:id="@+id/etSupabaseUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Supabase URL"
                android:inputType="textUri"/>

            <EditText
                android:id="@+id/etSupabaseKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Supabase Anon/Service Key"
                android:inputType="text"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gmail Webhook URL"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="16dp"/>

            <EditText
                android:id="@+id/etEmailWebhook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Webhook URL"
                android:inputType="textUri"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/btnSaveConfig"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Save"/>

                <Button
                    android:id="@+id/btnCancelEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cancel"
                    android:visibility="gone"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- Forwarding Destination Toggles -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Destinations"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <CheckBox
                android:id="@+id/cbEnableTelegram"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Telegram"
                android:checked="true"/>

            <CheckBox
                android:id="@+id/cbEnableSupabase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Supabase"
                android:checked="true"/>

            <CheckBox
                android:id="@+id/cbEnableWebhook"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gmail"
                android:checked="true"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- Message Forwarding Filter Options (Horizontal 1-Line) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Message Forwarding Filter"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <RadioGroup
            android:id="@+id/rgFilterMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rbFilterAll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="All"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rbFilterSms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SMS"/>

            <RadioButton
                android:id="@+id/rbFilterNotification"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Notification"/>
        </RadioGroup>

        <!-- SIM SMS Sender Filter -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SIM SMS Sender Filter"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="16dp"/>

        <CheckBox
            android:id="@+id/cbEnableSmsFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Only Allow MFS/Bank SMS (bKash, Nagad, Upay, 16216)"
            android:textStyle="bold"
            android:textSize="13sp"
            android:checked="true"
            android:layout_marginTop="4dp"/>

        <EditText
            android:id="@+id/etSmsSenderFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Allowed SMS senders (e.g. bkash, nagad, upay, 16216)"
            android:inputType="text"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp"/>

        <!-- Custom App Notification Filter & App Picker -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App Notification Filter"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="16dp"/>

        <Button
            android:id="@+id/btnSelectApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Apps"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/tvSelectedAppsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Target Apps: All Apps Allowed (Default)"
            android:textColor="#008000"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Permissions"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/btnGrantSmsPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SMS Permissions"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnGrantNotificationPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notification Access"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnDisableBatteryOpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Background Run"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvPendingCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Offline Unsent Queue: 0 messages"
            android:textColor="#008000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Ready"
            android:textColor="#333333"
            android:textSize="14sp"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>
