<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#22252A"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Apps to Intercept"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="14dp"/>

    <!-- Top Select All / Unselect All Checkbox -->
    <CheckBox
        android:id="@+id/cbSelectAllApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select All / Unselect All"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="15sp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#444444"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"/>

    <!-- App List -->
    <ListView
        android:id="@+id/lvAppList"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:choiceMode="multipleChoice"/>

    <!-- Vibrant High-Contrast Prominent Save Button -->
    <Button
        android:id="@+id/btnSaveAppSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SAVE SELECTION"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#7C4DFF"
        android:layout_marginTop="16dp"/>

</LinearLayout>
